relay.kooyu.app {
    encode gzip {
        match {
            header Content-Type application/json*
        }
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
    }
    reverse_proxy 127.0.0.1:4321 {
        flush_interval -1
    }
}
