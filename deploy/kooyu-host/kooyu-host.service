[Unit]
Description=Kooyu self-hosted work partner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kooyu
Group=kooyu
WorkingDirectory=/opt/kooyu
Environment=HOME=/var/lib/kooyu
Environment=KODO_DATA_DIR=/var/lib/kooyu
Environment=KOOYU_CREDENTIAL_BACKEND=file
Environment=KOOYU_VAULT_KEY_FILE=/etc/kooyu/vault.key
EnvironmentFile=-/etc/kooyu/host.env
ExecStart=/usr/bin/node /opt/kooyu/packages/host/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kooyu /srv/kooyu-workspaces
UMask=0077

[Install]
WantedBy=multi-user.target
